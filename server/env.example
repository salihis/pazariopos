# server/.env.example
# Copy to server/.env and fill in real values before running `pnpm dev:server`.

# PostgreSQL connection (matches docker/docker-compose.yml defaults)
# Note: host port is 5433 (not the default 5432) to avoid clashing with
# any PostgreSQL already installed locally on the dev machine.
DATABASE_URL="postgresql://pos_user:pos_password@localhost:5433/pos_erp?schema=public"

# Fastify
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:1420,https://tauri.localhost,tauri://localhost

# Auth — JWT signing secret. CHANGE THIS before any real deployment;
# the value below is a dev-only placeholder, not a secret.
JWT_SECRET=dev-only-change-me-before-production
JWT_EXPIRES_IN=12h
