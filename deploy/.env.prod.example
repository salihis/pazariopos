# deploy/.env.prod.example
# ─────────────────────────────────────────────────────────────
# Copy this to deploy/.env.prod on the VPS and fill in real values.
# NEVER commit the real .env.prod (already in .gitignore).
#
# Used by: docker-compose.pazariopos.yml — both for Postgres
# container credentials AND to build pazariopos-server's DATABASE_URL
# (see that file's `environment:` block).
# ─────────────────────────────────────────────────────────────

POSTGRES_USER=pazariopos_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=pazariopos_db

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_VALUE
